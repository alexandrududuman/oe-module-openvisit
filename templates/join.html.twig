<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="robots" content="noindex">
    <title>{{ 'Video visit'|xlt }}</title>
    <link rel="stylesheet" href="{{ assets|attr }}/css/visit.css">
</head>
<body class="openvisit-room openvisit-join">
<header class="openvisit-bar">
    <div class="openvisit-bar__who">
        <strong>{{ 'Video visit'|xlt }}</strong>
        <span class="text-muted ml-2">{{ startsAt|text }}</span>
    </div>
    <div class="openvisit-bar__status" id="openvisit-status" data-state="loading">{{ 'Connecting'|xlt }}&hellip;</div>
</header>
<main id="openvisit-meet"></main>
<div class="openvisit-ended d-none" id="openvisit-left">
    <h2>{{ 'You left the visit'|xlt }}</h2>
    <p>{{ 'If that was a mistake, reload this page to come back in.'|xlt }}</p>
</div>
<script type="application/json" id="openvisit-config">{{ clientConfig }}</script>
<script src="{{ assets|attr }}/js/join.js" defer></script>
</body>
</html>
