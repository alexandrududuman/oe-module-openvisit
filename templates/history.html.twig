<!DOCTYPE html>
<html>
<head>
    <title>{{ 'Telehealth history'|xlt }}</title>
    {{ setupHeader() }}
</head>
<body>
<div class="container-fluid mt-3">
    <h3>{{ 'Telehealth visits since'|xlt }} {{ since|text }}</h3>
    <p><a href="index.php">{{ 'Back to today'|xlt }}</a></p>
    {% if rows is empty %}
        <p id="openvisit-history-empty">{{ 'No visits yet.'|xlt }}</p>
    {% else %}
        <table class="table table-sm table-striped" id="openvisit-history">
            <thead><tr>
                <th>{{ 'Date'|xlt }}</th><th>{{ 'Time'|xlt }}</th><th>{{ 'Patient'|xlt }}</th><th>{{ 'Provider'|xlt }}</th>
                <th>{{ 'Visit'|xlt }}</th><th>{{ 'Started'|xlt }}</th><th>{{ 'Minutes'|xlt }}</th><th>{{ 'Joined'|xlt }}</th><th>{{ 'Encounter'|xlt }}</th>
            </tr></thead>
            <tbody>
            {% for row in rows %}
                <tr data-eid="{{ row.eid|attr }}">
                    <td>{{ row.date|text }}</td><td>{{ row.time|text }}</td><td>{{ row.patient|text }}</td><td>{{ row.provider|text }}</td>
                    <td>{{ row.status|text }}</td><td>{{ row.startedAt|text }}</td><td>{{ row.duration|text }}</td><td>{{ row.joined|text }}</td><td>{{ row.encounter|text }}</td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
    {% endif %}
</div>
</body>
</html>
