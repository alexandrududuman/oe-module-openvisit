{# OpenVisit override of the core portal appointment card: adds a Join button to telehealth visits, or a note once the visit has ended. #}
<div class="card m-0 col-12 col-md-6 col-lg-4">
    <div class="card-header">
        {% if past == false and viewOnlyAppointments == false %}
            <a href="#" onclick="editAppointment({{ appt.mode | attr_js }},{{ appt.pc_eid | attr_js }})" title="{{ appt.etitle | attr }}">
                <i class='float-right fa fa-edit fa-lg {% if appt.pc_recurrtype > 0 %} text-danger {% else %} text-success {% endif %} bg-light font-weight-light'></i>
            </a>
        {% endif %}
    </div>
    <div class="card-body p-0 font-weight-bold">
        <p>
            {{ appt.appointmentDate | text }}<br>
            {{ appt.appointmentType | text }}<br>
            {{ appt.provider | text }}<br>
            {{ appt.status | text }}
        </p>
        {% if appt.openvisitJoinUrl is defined and past == false %}
            <p>
                <a class="btn btn-primary btn-sm openvisit-portal-join" target="_blank" rel="noopener" href="{{ appt.openvisitJoinUrl | attr }}">
                    <i class="fa fa-video mr-1" aria-hidden="true"></i>{{ 'Join video visit' | xlt }}
                </a>
            </p>
        {% endif %}
        {% if appt.openvisitEnded is defined and past == false %}
            <p class="text-muted font-weight-normal openvisit-portal-ended">
                <i class="fa fa-video-slash mr-1" aria-hidden="true"></i>{{ 'This video visit has ended' | xlt }}
            </p>
        {% endif %}
    </div>
</div>
