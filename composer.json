{
    "name": "alexandrududuman/oe-module-openvisit",
    "description": "Self-hosted Jitsi video visits for OpenEMR",
    "type": "openemr-module",
    "license": "GPL-3.0-or-later",
    "keywords": [
        "openemr",
        "openemr-module",
        "telehealth",
        "jitsi",
        "video-visits"
    ],
    "homepage": "https://github.com/alexandrududuman/oe-module-openvisit",
    "authors": [
        {
            "name": "Alexandru Duduman",
            "email": "alexandru@thepenguindeveloper.com"
        }
    ],
    "support": {
        "issues": "https://github.com/alexandrududuman/oe-module-openvisit/issues",
        "source": "https://github.com/alexandrududuman/oe-module-openvisit",
        "security": "https://github.com/alexandrududuman/oe-module-openvisit/blob/main/SECURITY.md"
    },
    "require": {
        "php": ">=8.3",
        "openemr/oe-module-installer-plugin": "^0.1.5"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.70",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^12.0"
    },
    "conflict": {
        "openemr/openemr": "<8.5.0"
    },
    "autoload": {
        "psr-4": {
            "OpenVisit\\OpenEMR\\Modules\\OpenVisit\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "OpenVisit\\OpenEMR\\Modules\\OpenVisit\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "openemr/oe-module-installer-plugin": true
        }
    },
    "scripts": {
        "test": "phpunit",
        "phpstan": "phpstan analyse",
        "cs": "php-cs-fixer fix --dry-run --diff",
        "cs-fix": "php-cs-fixer fix",
        "check": [
            "@cs",
            "@phpstan",
            "@test"
        ]
    }
}
