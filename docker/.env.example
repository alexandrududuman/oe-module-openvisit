# Domains. Each needs an A record pointing at this host.
EMR_DOMAIN=emr.clinic.example
MEET_DOMAIN=meet.clinic.example
TURN_DOMAIN=meet.clinic.example
PUBLIC_IP=203.0.113.10
ACME_EMAIL=admin@clinic.example
TZ=Europe/Bucharest

# OpenEMR
OPENEMR_VERSION=8.5.0
OE_ADMIN_USER=admin
OE_ADMIN_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-me
MYSQL_OPENEMR_PASSWORD=change-me

# Jitsi. Generate secrets with: openssl rand -hex 32
JITSI_VERSION=stable-11248-3
JWT_APP_ID=openvisit
JWT_APP_SECRET=change-me
JICOFO_AUTH_PASSWORD=change-me
JVB_AUTH_PASSWORD=change-me
TURN_SECRET=change-me

# Recording (optional). The recorder needs about 2 GB of RAM while it records.
# To turn it on: ENABLE_RECORDING=1, COMPOSE_PROFILES=recording, two passwords below.
ENABLE_RECORDING=0
COMPOSE_PROFILES=
JIBRI_XMPP_PASSWORD=change-me
JIBRI_RECORDER_PASSWORD=change-me
